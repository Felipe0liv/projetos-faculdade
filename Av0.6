//Verificação de Número Primo: Desenvolva um programa que leia um número inteiro e determine se ele é um número primo ou não.

#include <stdio.h>

int main() {
    int n, cont = 0;
    scanf("%d", &n);
    
    for (int i = 1; i <= n; i++) {
        if(n%i==0){
        cont++;
        }
    }
    
    if (n<2){
        printf("Não é primo");
    }else if (cont>2){
        printf("Não é primo");
    }else{
        printf("É primo");
    }

    return 0;
}
