#include <iostream>
#include <string>
using namespace std;

class banco {
public:
 double saldo = 1000000;

 void depositar(double valor) {
 saldo = saldo + valor;
 cout << saldo << endl;
 }

 void sacar(double valor) {
 if(saldo>=valor){
 saldo = saldo - valor;
 cout << saldo << endl;
 } else{
 cout<<"você não tem saldo suficiente"<<endl;
   }
 }

 void consultarSaldo() {
 cout << saldo << endl;
 }

};

int main() {
 banco sald;

 sald.depositar(10);
 sald.sacar(1000);
 sald.consultarSaldo();
 

 return 0;
}
