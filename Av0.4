//Conversão de Temperatura: Escreva um programa que converta uma temperatura fornecida em graus Celsius para Fahrenheit e vice-versa.

#include <stdio.h>

float ConvCelsius(float n){

float x=0;

x=(n*1.8)+32;

return x;

}

float ConvFahr(float n){

float x=0;

x=(n-32)/1.8;

return x;

}

int main() {
    float n,y;
    char m;
    
    scanf("%f%c", &n, &m);

    if(m=='c'){
    y = ConvCelsius(n);
    }else{
    y = ConvFahr(n);
    }

    printf("%f", y);

    return 0;
}
