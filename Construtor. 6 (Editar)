#include <iostream>
using namespace std;
class TesteParametros {
public:
 // Função com parâmetro por valor
 void dobrarPorValor(int x) {
 x = x * 2;
 cout << "Dentro da função (valor): " << x << endl;
 }

 // Função com parâmetro por referência
 void dobrarPorReferencia(int &x) {
 x = x * 2;
 cout << "Dentro da função (referência): " << x << endl;
 }

 // Função que modifica objeto por valor (cópia)
 void modificarObjetoPorValor(Pessoa p) {
 p.nome = "Modificado";
 cout << "Dentro da função (objeto por valor): " << p.nome << endl;
 }

 // Função que modifica objeto por referência
 void modificarObjetoPorReferencia(Pessoa &p) {
 p.nome = "Modificado";
 cout << "Dentro da função (objeto por referência): " << p.nome <<
endl;
 }
};
// Classe auxiliar para o exemplo
class Pessoa {
public:
 string nome;
 int idade;

 Pessoa(string n, int i) {
 nome = n;
 idade = i;
 }

 void exibir() {
 cout << "Nome: " << nome << ", Idade: " << idade << endl;
 }
};
int main() {
 TesteParametros teste;

 // Teste com inteiro
 int numero = 5;
 cout << "Antes (valor): " << numero << endl;
 teste.dobrarPorValor(numero);
 cout << "Depois (valor): " << numero << endl;

 cout << endl;

 numero = 5; // Resetando
 cout << "Antes (referência): " << numero << endl;
 teste.dobrarPorReferencia(numero);
 cout << "Depois (referência): " << numero << endl;

 cout << endl;

 // Teste com objeto
 Pessoa pessoa("João", 25);
 cout << "Antes (objeto por valor): ";
 pessoa.exibir();
 teste.modificarObjetoPorValor(pessoa);
 cout << "Depois (objeto por valor): ";
 pessoa.exibir();

 cout << endl;

 cout << "Antes (objeto por referência): ";
 pessoa.exibir();
 teste.modificarObjetoPorReferencia(pessoa);
 cout << "Depois (objeto por referência): ";
 pessoa.exibir();

 return 0;
}
