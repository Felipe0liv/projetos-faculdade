#include <iostream>
#include <string>
using namespace std;

class Conectado {
public:
    bool aberto;

 
    Conectado() {
        aberto = true;
        cout << "Conectado com sucesso!" << endl;
    }


    ~Conectado() {
        if (aberto) {
            cout << "Desconectado..." << endl;
            aberto = false;
        }
    }
};

int main() {
    cout << "Conectando..." << endl;

    {   
        Conectado conexao;

        cout << "Fim da conexão - você será desconectado" << endl;
    } 

    cout << "Desconectado" << endl;

    return 0;
}
