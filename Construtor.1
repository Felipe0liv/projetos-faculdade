#include <iostream>
#include <string>
using namespace std;

class Retangulo {
public:

    float largura, altura;

    double calcularArea() {
        return largura * altura;
    }

    Retangulo(float l, float a) {
        largura = l;
        altura = a;
    }

    void exibirret() {
        cout << altura << " " << largura << endl;
        cout << "Área: " << calcularArea() << endl;
    }
};

int main() {

    Retangulo ret1(30, 1.91);
    Retangulo ret2(21, 2.00);

    ret1.exibirret();
    ret2.exibirret();

    return 0;
}
