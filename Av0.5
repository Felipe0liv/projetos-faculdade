//Contagem de Caracteres em uma String: Crie um programa que leia uma string e conte quantos caracteres (incluindo espaços) ela possui.

#include <stdio.h>

int main() {
    int n[5], x = 0;
    
    for (int i = 0; i < 5; i++) {
        scanf("%d", &n[i]);
        x = x + n[i];
    }

    printf("%d", x);

    return 0;
}
