#include <iostream>
#include <string>
using namespace std;
class Contador {
public:
 string nome;

 // Variável estática - pertence à classe, não ao objeto
 static int totalObjetos;

 // Construtor
 Contador(string n) {
 nome = n;
 totalObjetos++; // Incrementa o contador estático
 cout << "Criado: " << nome << " (Total: " << totalObjetos << ")"
<< endl;
 }

 // Destrutor
 ~Contador() {
 totalObjetos--; // Decrementa o contador estático
 cout << "Destruído: " << nome << " (Total: " << totalObjetos <<
")" << endl;
 }

 // Método estático - pode ser chamado sem criar objeto
 static void mostrarTotal() {
 cout << "Total de objetos: " << totalObjetos << endl;
 }
};
// Inicializando a variável estática (fora da classe)
int Contador::totalObjetos = 0;
int main() {
 cout << "Início do programa" << endl;
 Contador::mostrarTotal(); // Chamando método estático

 {
 Contador obj1("Primeiro");
 Contador obj2("Segundo");
 Contador::mostrarTotal();

 {
 Contador obj3("Terceiro");
 Contador::mostrarTotal();
 } // obj3 destruído aqui

 Contador::mostrarTotal();
 } // obj1 e obj2 destruídos aqui

 Contador::mostrarTotal();
 cout << "Fim do programa" << endl;

 return 0;
}
