#include <iostream>
#include <string>
using namespace std;

class Contador {
public:
    string nome;
    int sal;

    static int totalObjetos;

    Contador(string n, int s) {
        nome = n;
        sal = s;
        totalObjetos++;

        cout << nome
             << " salario: " << sal
             << " Berries "
             << " (Total: " << totalObjetos << ")"
             << endl;
    }

    ~Contador() {
        totalObjetos--;

        cout << "Destruído: " << nome
             << " (Total: " << totalObjetos << ")"
             << endl;
    }

    static void mostrarTotal() {
        cout << "Total de objetos: " << totalObjetos << endl;
    }
};

int Contador::totalObjetos = 0;

int main() {
    cout << "Início do programa" << endl;

    Contador::mostrarTotal();

    {
        Contador obj1("goku", 30);
        Contador obj2("luffY", 1000000);

        Contador::mostrarTotal();

        {
            Contador obj3("naruto", 1200);
            Contador obj4("tanjiro", 1800);

            Contador::mostrarTotal();
        }

        {
            Contador obj5("BRUNO ARRASCAETA RIBEIRO GOL", 2019);

            Contador::mostrarTotal();
        }

        Contador::mostrarTotal();
    }

    Contador::mostrarTotal();

    cout << "Fim do programa" << endl;

    return 0;
}
