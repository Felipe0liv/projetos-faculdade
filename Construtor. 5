#include <iostream>
#include <string>
using namespace std;

class Calculadora {
public:

 int somar(int a, int b) {
 cout << "Soma de inteiros: ";
 return a + b;
 }


 double somar(double a, double b) {
 cout << "Soma de decimais: ";
 return a + b;
 }


 int somar(int a, int b, int c) {
 cout << "Soma de três inteiros: ";
 return a + b + c;
 }

 
 double somar(int a, double b) {
 cout << "Soma Um inteiro e um double: ";
 return a + b;
 }

};

int main() {
 Calculadora calc;

 cout << calc.somar(5, 3) << endl;
 cout << calc.somar(2.5, 3.7) << endl;
 cout << calc.somar(1, 2, 3) << endl;
 cout << calc.somar(67, 6.7) << endl;

 return 0;
}
