/*Criado o método pesquisarNome(string termo) na classe Agencia:
O que faz: Percorre o vetor de astronautas cadastrados e utiliza a função .find(termo) da classe string para verificar se o termo pesquisado faz parte do nome do astronauta. Caso encontre, imprime o CPF, o nome completo, a idade e o estado atual do astronauta (disponível, em voo ou morto). Se não encontrar nenhuma correspondência, exibe (nenhum).
Por quê? Para satisfazer a exigência de uma nova funcionalidade livre na Missão 4, permitindo localizar rapidamente astronautas de forma flexível por texto sem precisar de listar toda a base de dados.
Modificado o ciclo de comandos (main) na função principal:
O que faz: Adicionou-se uma nova condição (else if (comando == "PESQUISAR_NOME")) que lê o termo de busca enviado pela entrada padrão utilizando getline (permitindo inclusive nomes compostos) e invoca o método pesquisarNome(termo) criado na classe Agencia.
Por quê? Para garantir que o programa passe a reconhecer e a processar corretamente o novo comando enviado via terminal ou ficheiro de teste.*/


#include <iostream>
#include <string>
#include <vector>
#include <sstream>
#include <fstream>

using namespace std;

class Astronauta {
private:
    string cpf;
    string nome;
    int idade;
    bool vivo;
    bool disponivel;

public:
    Astronauta(string c, string n, int i) {
        cpf = c;
        nome = n;
        idade = i;
        vivo = true;
        disponivel = true;
    }

    string getCpf() { return cpf; }
    string getNome() { return nome; }
    int getIdade() { return idade; }
    bool estaVivo() { return vivo; }
    bool estaDisponivel() { return disponivel; }

    void embarcar() {
        disponivel = false;
    }

    void desembarcar() {
        if (vivo) {
            disponivel = true;
        }
    }

    void morrer() {
        vivo = false;
        disponivel = false;
    }
};

class Voo {
private:
    int codigo;
    string estado;
    vector<string> cpfs;

public:
    Voo(int c) {
        codigo = c;
        estado = "planejado";
    }

    int getCodigo() { return codigo; }
    string getEstado() { return estado; }
    void setEstado(string e) { estado = e; }
    
    int getQuantidadeAstronautas() { return cpfs.size(); }
    string getCpf(int posicao) { return cpfs[posicao]; }

    bool temAstronauta(string cpf) {
        for (size_t i = 0; i < cpfs.size(); i++) {
            if (cpfs[i] == cpf) {
                return true;
            }
        }
        return false;
    }

    void adicionarAstronauta(string cpf) {
        cpfs.push_back(cpf);
    }

    bool removerAstronauta(string cpf) {
        for (size_t i = 0; i < cpfs.size(); i++) {
            if (cpfs[i] == cpf) {
                cpfs.erase(cpfs.begin() + i);
                return true;
            }
        }
        return false;
    }

    void lancar() { estado = "em curso"; }
    void explodir() { estado = "finalizado com explosao"; }
    void finalizar() { estado = "finalizado com sucesso"; }
};

class Agencia {
private:
    vector<Astronauta> astronautas;
    vector<Voo> voos;

    int buscarAstronauta(string cpf) {
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (astronautas[i].getCpf() == cpf) {
                return i;
            }
        }
        return -1;
    }

    int buscarVoo(int codigo) {
        for (size_t i = 0; i < voos.size(); i++) {
            if (voos[i].getCodigo() == codigo) {
                return i;
            }
        }
        return -1;
    }

public:
    void cadastrarAstronauta(string cpf, string nome, int idade) {
        if (buscarAstronauta(cpf) != -1) {
            cout << "ERRO: astronauta com CPF " << cpf << " ja cadastrado" << endl;
            return;
        }
        astronautas.push_back(Astronauta(cpf, nome, idade));
        cout << "OK: astronauta " << cpf << " cadastrado" << endl;
    }

    void cadastrarVoo(int codigo) {
        if (buscarVoo(codigo) != -1) {
            cout << "ERRO: voo " << codigo << " ja cadastrado" << endl;
            return;
        }
        voos.push_back(Voo(codigo));
        cout << "OK: voo " << codigo << " cadastrado" << endl;
    }

    void adicionarAstronauta(string cpf, int codigo) {
        int posA = buscarAstronauta(cpf);
        int posV = buscarVoo(codigo);

        if (posA == -1) {
            cout << "ERRO: astronauta " << cpf << " nao cadastrado" << endl;
            return;
        }
        if (posV == -1) {
            cout << "ERRO: voo " << codigo << " nao cadastrado" << endl;
            return;
        }
        if (voos[posV].getEstado() != "planejado") {
            cout << "ERRO: voo " << codigo << " nao esta planejado" << endl;
            return;
        }
        if (!astronautas[posA].estaVivo()) {
            cout << "ERRO: astronauta " << cpf << " esta morto" << endl;
            return;
        }
        if (voos[posV].temAstronauta(cpf)) {
            cout << "ERRO: astronauta " << cpf << " ja esta no voo " << codigo << endl;
            return;
        }

        voos[posV].adicionarAstronauta(cpf);
        cout << "OK: astronauta " << cpf << " adicionado ao voo " << codigo << endl;
    }

    void removerAstronauta(string cpf, int codigo) {
        int posA = buscarAstronauta(cpf);
        int posV = buscarVoo(codigo);

        if (posA == -1) {
            cout << "ERRO: astronauta " << cpf << " nao cadastrado" << endl;
            return;
        }
        if (posV == -1) {
            cout << "ERRO: voo " << codigo << " nao cadastrado" << endl;
            return;
        }
        if (voos[posV].getEstado() != "planejado") {
            cout << "ERRO: voo " << codigo << " nao esta planejado" << endl;
            return;
        }
        if (!voos[posV].removerAstronauta(cpf)) {
            cout << "ERRO: astronauta " << cpf << " nao esta no voo " << codigo << endl;
            return;
        }

        cout << "OK: astronauta " << cpf << " removido do voo " << codigo << endl;
    }

    void lancarVoo(int codigo) {
        int posV = buscarVoo(codigo);
        if (posV == -1) {
            cout << "ERRO: voo " << codigo << " nao cadastrado" << endl;
            return;
        }
        if (voos[posV].getEstado() != "planejado") {
            cout << "ERRO: voo " << codigo << " nao esta planejado" << endl;
            return;
        }
        if (voos[posV].getQuantidadeAstronautas() == 0) {
            cout << "ERRO: voo " << codigo << " nao possui astronautas" << endl;
            return;
        }

        for (int i = 0; i < voos[posV].getQuantidadeAstronautas(); i++) {
            string cpf = voos[posV].getCpf(i);
            int posA = buscarAstronauta(cpf);
            if (!astronautas[posA].estaVivo()) {
                cout << "ERRO: astronauta " << cpf << " esta morto" << endl;
                return;
            }
            if (!astronautas[posA].estaDisponivel()) {
                cout << "ERRO: astronauta " << cpf << " esta indisponivel" << endl;
                return;
            }
        }

        voos[posV].lancar();
        for (int i = 0; i < voos[posV].getQuantidadeAstronautas(); i++) {
            int posA = buscarAstronauta(voos[posV].getCpf(i));
            astronautas[posA].embarcar();
        }
        cout << "OK: voo " << codigo << " lancado" << endl;
    }

    void explodirVoo(int codigo) {
        int posV = buscarVoo(codigo);
        if (posV == -1) {
            cout << "ERRO: voo " << codigo << " nao cadastrado" << endl;
            return;
        }
        if (voos[posV].getEstado() != "em curso") {
            cout << "ERRO: voo " << codigo << " nao esta em curso" << endl;
            return;
        }

        voos[posV].explodir();
        for (int i = 0; i < voos[posV].getQuantidadeAstronautas(); i++) {
            int posA = buscarAstronauta(voos[posV].getCpf(i));
            astronautas[posA].morrer();
        }
        cout << "OK: voo " << codigo << " explodiu" << endl;
    }

    void finalizarVoo(int codigo) {
        int posV = buscarVoo(codigo);
        if (posV == -1) {
            cout << "ERRO: voo " << codigo << " nao cadastrado" << endl;
            return;
        }
        if (voos[posV].getEstado() != "em curso") {
            cout << "ERRO: voo " << codigo << " nao esta em curso" << endl;
            return;
        }

        voos[posV].finalizar();
        for (int i = 0; i < voos[posV].getQuantidadeAstronautas(); i++) {
            int posA = buscarAstronauta(voos[posV].getCpf(i));
            astronautas[posA].desembarcar();
        }
        cout << "OK: voo " << codigo << " finalizado com sucesso" << endl;
    }

    void listarVoos() {
        cout << "LISTA DE VOOS" << endl;
        string estados[4] = {"planejado", "em curso", "finalizado com sucesso", "finalizado com explosao"};
        
        for (int e = 0; e < 4; e++) {
            cout << "== " << estados[e] << " ==" << endl;
            bool encontrou = false;
            for (size_t i = 0; i < voos.size(); i++) {
                if (voos[i].getEstado() == estados[e]) {
                    encontrou = true;
                    cout << "Voo " << voos[i].getCodigo() << ": ";
                    int qtd = voos[i].getQuantidadeAstronautas();
                    if (qtd == 0) {
                        cout << "sem astronautas" << endl;
                    } else {
                        for (int j = 0; j < qtd; j++) {
                            string cpf = voos[i].getCpf(j);
                            int posA = buscarAstronauta(cpf);
                            cout << cpf << " " << astronautas[posA].getNome();
                            if (j < qtd - 1) cout << ", ";
                        }
                        cout << endl;
                    }
                }
            }
            if (!encontrou) {
                cout << "(nenhum)" << endl;
            }
        }
    }

    void listarMortos() {
        cout << "ASTRONAUTAS MORTOS" << endl;
        bool temMorto = false;
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (!astronautas[i].estaVivo()) {
                temMorto = true;
                cout << astronautas[i].getCpf() << " " << astronautas[i].getNome() << " - voos:";
                for (size_t v = 0; v < voos.size(); v++) {
                    if (voos[v].getEstado() != "planejado" && voos[v].temAstronauta(astronautas[i].getCpf())) {
                        cout << " " << voos[v].getCodigo();
                    }
                }
                cout << endl;
            }
        }
        if (!temMorto) {
            cout << "(nenhum)" << endl;
        }
    }

    void listarAstronautas() {
        cout << "LISTA DE ASTRONAUTAS" << endl;
        
        cout << "== disponiveis ==" << endl;
        bool temDisp = false;
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (astronautas[i].estaVivo()) {
                bool emVooEmCurso = false;
                for (size_t v = 0; v < voos.size(); v++) {
                    if (voos[v].getEstado() == "em curso" && voos[v].temAstronauta(astronautas[i].getCpf())) {
                        emVooEmCurso = true;
                        break;
                    }
                }
                if (!emVooEmCurso) {
                    temDisp = true;
                    cout << astronautas[i].getCpf() << " " << astronautas[i].getNome() << " (" << astronautas[i].getIdade() << " anos)" << endl;
                }
            }
        }
        if (!temDisp) {
            cout << "(nenhum)" << endl;
        }

        cout << "== em voo ==" << endl;
        bool temEmVoo = false;
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (astronautas[i].estaVivo()) {
                for (size_t v = 0; v < voos.size(); v++) {
                    if (voos[v].getEstado() == "em curso" && voos[v].temAstronauta(astronautas[i].getCpf())) {
                        temEmVoo = true;
                        cout << astronautas[i].getCpf() << " " << astronautas[i].getNome() << " (" << astronautas[i].getIdade() << " anos) - voo " << voos[v].getCodigo() << endl;
                    }
                }
            }
        }
        if (!temEmVoo) {
            cout << "(nenhum)" << endl;
        }

        cout << "== mortos ==" << endl;
        bool temMorto = false;
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (!astronautas[i].estaVivo()) {
                temMorto = true;
                cout << astronautas[i].getCpf() << " " << astronautas[i].getNome() << " (" << astronautas[i].getIdade() << " anos)" << endl;
            }
        }
        if (!temMorto) {
            cout << "(nenhum)" << endl;
        }
    }

    void historicoAstronauta(string cpf) {
        int posA = buscarAstronauta(cpf);
        if (posA == -1) {
            cout << "ERRO: astronauta " << cpf << " nao cadastrado" << endl;
            return;
        }

        cout << "HISTORICO DE " << astronautas[posA].getCpf() << " " << astronautas[posA].getNome() << endl;
        bool participou = false;

        for (size_t v = 0; v < voos.size(); v++) {
            if (voos[v].getEstado() != "planejado" && voos[v].temAstronauta(cpf)) {
                participou = true;
                cout << "voo " << voos[v].getCodigo() << ": " << voos[v].getEstado() << endl;
            }
        }

        if (!participou) {
            cout << "(nenhum voo)" << endl;
        }
    }

    void salvar(string nomeArquivo) {
        ofstream arquivo(nomeArquivo);
        if (!arquivo.is_open()) {
            return;
        }

        arquivo << astronautas.size() << endl;
        for (size_t i = 0; i < astronautas.size(); i++) {
            arquivo << astronautas[i].getCpf() << " " << astronautas[i].getIdade() << " " 
                    << astronautas[i].estaVivo() << " " << astronautas[i].estaDisponivel() << " " 
                    << astronautas[i].getNome() << endl;
        }

        arquivo << voos.size() << endl;
        for (size_t i = 0; i < voos.size(); i++) {
            arquivo << voos[i].getCodigo() << " " << voos[i].getEstado() << " " 
                    << voos[i].getQuantidadeAstronautas();
            for (int j = 0; j < voos[i].getQuantidadeAstronautas(); j++) {
                arquivo << " " << voos[i].getCpf(j);
            }
            arquivo << endl;
        }

        arquivo.close();
        cout << "OK: dados salvos em " << nomeArquivo << endl;
    }

    void carregar(string nomeArquivo) {
        ifstream arquivo(nomeArquivo);
        if (!arquivo.is_open()) {
            cout << "ERRO: nao foi possivel abrir o arquivo " << nomeArquivo << " para leitura" << endl;
            return;
        }

        vector<Astronauta> tempAstronautas;
        vector<Voo> tempVoos;

        size_t qtdAstronautas;
        arquivo >> qtdAstronautas;
        for (size_t i = 0; i < qtdAstronautas; i++) {
            string cpf, nome;
            int idade;
            bool vivo, disponivel;
            arquivo >> cpf >> idade >> vivo >> disponivel;
            getline(arquivo >> ws, nome);
            
            Astronauta a(cpf, nome, idade);
            if (!vivo) a.morrer();
            else if (!disponivel) a.embarcar();
            
            tempAstronautas.push_back(a);
        }

        size_t qtdVoos;
        arquivo >> qtdVoos;
        for (size_t i = 0; i < qtdVoos; i++) {
            int codigo;
            string estado;
            int qtdCpfs;
            arquivo >> codigo >> estado >> qtdCpfs;
            
            Voo v(codigo);
            v.setEstado(estado);
            for (int j = 0; j < qtdCpfs; j++) {
                string cpfC;
                arquivo >> cpfC;
                v.adicionarAstronauta(cpfC);
            }
            tempVoos.push_back(v);
        }

        arquivo.close();
        astronautas = tempAstronautas;
        voos = tempVoos;
        cout << "OK: dados carregados de " << nomeArquivo << endl;
    }

    void relatorio() {
        cout << "RELATORIO" << endl;
        
        int totalA = astronautas.size();
        int vivosA = 0;
        int mortosA = 0;
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (astronautas[i].estaVivo()) vivosA++;
            else mortosA++;
        }
        
        int p = 0, ec = 0, fs = 0, fe = 0;
        for (size_t i = 0; i < voos.size(); i++) {
            string st = voos[i].getEstado();
            if (st == "planejado") p++;
            else if (st == "em curso") ec++;
            else if (st == "finalizado com sucesso") fs++;
            else if (st == "finalizado com explosao") fe++;
        }
        
        int totalFinalizados = fs + fe;
        double taxaSucesso = 0.0;
        if (totalFinalizados > 0) {
            taxaSucesso = ((double)fs / totalFinalizados) * 100.0;
        }

        cout << "astronautas: " << totalA << " (vivos: " << vivosA << ", mortos: " << mortosA << ")" << endl;
        cout << "voos: planejados=" << p << ", em curso=" << ec << ", sucesso=" << fs << ", explosao=" << fe << endl;
        cout << "taxa de sucesso: " << taxaSucesso << "%" << endl;
    }

    void pesquisarNome(string termo) {
        cout << "PESQUISA DE ASTRONAUTAS: " << termo << endl;
        bool encontrou = false;
        for (size_t i = 0; i < astronautas.size(); i++) {
            if (astronautas[i].getNome().find(termo) != string::npos) {
                encontrou = true;
                string estado = "disponivel";
                if (!astronautas[i].estaVivo()) {
                    estado = "morto";
                } else if (!astronautas[i].estaDisponivel()) {
                    estado = "em voo";
                }
                cout << astronautas[i].getCpf() << " " << astronautas[i].getNome() 
                     << " (" << astronautas[i].getIdade() << " anos) [" << estado << "]" << endl;
            }
        }
        if (!encontrou) {
            cout << "(nenhum)" << endl;
        }
    }
};

int main() {
    Agencia agencia;
    string linha;

    while (getline(cin, linha)) {
        if (linha.empty()) continue;
        
        stringstream ss(linha);
        string comando;
        ss >> comando;

        if (comando == "FIM") {
            break;
        } 
        else if (comando == "CADASTRAR_ASTRONAUTA") {
            string cpf;
            int idade;
            string nome;
            ss >> cpf >> idade;
            getline(ss >> ws, nome);
            agencia.cadastrarAstronauta(cpf, nome, idade);
        } 
        else if (comando == "CADASTRAR_VOO") {
            int codigo;
            ss >> codigo;
            agencia.cadastrarVoo(codigo);
        } 
        else if (comando == "ADICIONAR_ASTRONAUTA") {
            string cpf;
            int codigo;
            ss >> cpf >> codigo;
            agencia.adicionarAstronauta(cpf, codigo);
        } 
        else if (comando == "REMOVER_ASTRONAUTA") {
            string cpf;
            int codigo;
            ss >> cpf >> codigo;
            agencia.removerAstronauta(cpf, codigo);
        } 
        else if (comando == "LANCAR_VOO") {
            int codigo;
            ss >> codigo;
            agencia.lancarVoo(codigo);
        } 
        else if (comando == "EXPLODIR_VOO") {
            int codigo;
            ss >> codigo;
            agencia.explodirVoo(codigo);
        } 
        else if (comando == "FINALIZAR_VOO") {
            int codigo;
            ss >> codigo;
            agencia.finalizarVoo(codigo);
        } 
        else if (comando == "LISTAR_VOOS") {
            agencia.listarVoos();
        } 
        else if (comando == "LISTAR_MORTOS") {
            agencia.listarMortos();
        } 
        else if (comando == "LISTAR_ASTRONAUTAS") {
            agencia.listarAstronautas();
        } 
        else if (comando == "HISTORICO") {
            string cpf;
            ss >> cpf;
            agencia.historicoAstronauta(cpf);
        } 
        else if (comando == "SALVAR") {
            string nomeArquivo;
            ss >> nomeArquivo;
            agencia.salvar(nomeArquivo);
        } 
        else if (comando == "CARREGAR") {
            string nomeArquivo;
            ss >> nomeArquivo;
            agencia.carregar(nomeArquivo);
        } 
        else if (comando == "RELATORIO") {
            agencia.relatorio();
        } 
        else if (comando == "PESQUISAR_NOME") {
            string termo;
            getline(ss >> ws, termo);
            agencia.pesquisarNome(termo);
        } 
        else {
            cout << "ERRO: comando desconhecido " << comando << endl;
        }
    }

    return 0;
}
